# ==============================================================================
# SearXNG Environment Configuration Template
# Copy this file to .env before starting containers:
#   PowerShell: Copy-Item .env.example .env
# ==============================================================================

# Container image version tag (defaults to "latest")
SEARXNG_VERSION=latest

# Listen host: 127.0.0.1 restricts network access strictly to localhost
SEARXNG_HOST=127.0.0.1

# Listen port on host
SEARXNG_PORT=8080

# Base URL of the SearXNG instance
SEARXNG_BASE_URL=http://localhost:8080/

# Cryptographically strong secret key used for session encryption and CSRF tokens
# Generate with Python in PowerShell:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Or in pure PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
SEARXNG_SECRET=replace_with_a_generated_64_char_hex_secret

# Valkey internal connection string
SEARXNG_VALKEY_URL=valkey://searxng-valkey:6379/0
