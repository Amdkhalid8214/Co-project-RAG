# ============================================================
# DocuChat Production RAG - Environment Configuration
# ============================================================

# App Configuration
APP_NAME="DocuChat Production RAG"
DEBUG=true
HOST=0.0.0.0
PORT=5000

# Database Configuration (SQLite default; can use PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/rag_app.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_app

# LLM Configuration (Ollama with Qwen)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT=180.0
LLM_NUM_THREADS=8                  # CPU thread count (matches physical cores)
LLM_NUM_CTX=2048                   # Context window size in tokens


# Embedding Configuration
# Default BAAI/bge-small-en-v1.5 (384 dim). Options: sentence-transformers or ollama
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=doc_chunks

# Document Parser (Docling)
DOCLING_URL=http://localhost:5001

# Reranker Model
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true

# Retrieval & Fusion Tuning
ROUTER_MODE=hybrid                 # 'hybrid', 'rule', or 'llm'
RETRIEVAL_TOP_K=30                # Candidates retrieved from each method (vector & BM25)
FUSION_METHOD=rrf                 # 'rrf' (Reciprocal Rank Fusion) or 'weighted'
RRF_K=60                          # Constant for RRF formula: 1 / (k + rank)
FUSION_ALPHA=0.5                  # Weight for vector search if weighted fusion is used
DEDUP_SIMILARITY_THRESHOLD=0.88   # Jaccard 3-gram threshold for discarding near duplicates
FINAL_TOP_K=3                     # Final top chunks fed into context window (3 is optimal for low CPU latency)
SCORE_THRESHOLD=0.25              # Minimum relevance score to qualify chunks
