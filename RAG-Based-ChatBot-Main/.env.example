# ============================================================
# DocuChat AI (9/10 Production Architecture) - Environment Configuration
# ============================================================

# App Configuration
APP_NAME="DocuChat Production RAG"
DEBUG=true
HOST=0.0.0.0
PORT=5000

# Security & Authentication
SECRET_KEY=change_this_to_a_random_32_byte_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Relational Database (PostgreSQL with asyncpg; SQLite fallback supported)
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb
# SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./data/rag_app.db

# Redis Message Broker & Cache
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Ollama with verified Qwen 2.5 3B)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_TIMEOUT=180.0
LLM_NUM_THREADS=8                  # CPU thread count (matches physical cores)
LLM_NUM_CTX=8192                   # Context window size in tokens

# Embedding Configuration (nomic-embed-text:v1.5 or BAAI/bge-small-en-v1.5)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIM=768

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=doc_chunks

# Document Parser (Docling)
DOCLING_URL=http://localhost:5001

# Reranker Model
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true

# Retrieval & Fusion Tuning
ROUTER_MODE=hybrid                 # 'hybrid', 'rule', or 'llm'
RETRIEVAL_TOP_K=30                # Candidates retrieved from each method (vector & BM25)
FUSION_METHOD=rrf                 # 'rrf' (Reciprocal Rank Fusion) or 'weighted'
RRF_K=60                          # Constant for RRF formula: 1 / (k + rank)
FUSION_ALPHA=0.5                  # Weight for vector search if weighted fusion is used
DEDUP_SIMILARITY_THRESHOLD=0.88   # Jaccard 3-gram threshold for discarding near duplicates
FINAL_TOP_K=3                     # Final top chunks fed into context window
SCORE_THRESHOLD=0.25              # Minimum relevance score to qualify chunks

# Chunking Limits
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=50

